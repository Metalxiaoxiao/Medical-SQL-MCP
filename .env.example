# Database Configuration
# Choose one database type: mysql, postgres, or elasticsearch
DB_TYPE=mysql

# MySQL Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_DATABASE=medical_db

# PostgreSQL Configuration
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=
# DB_DATABASE=medical_db
# DB_SCHEMA=public

# Elasticsearch Configuration
# Uncomment and configure when using Elasticsearch
# ELASTICSEARCH_NODE=http://localhost:9200
# ELASTICSEARCH_USERNAME=
# ELASTICSEARCH_PASSWORD=
# ELASTICSEARCH_TLS=false
# ELASTICSEARCH_INDEX_PREFIX=medical_
# ELASTICSEARCH_DEFAULT_INDEX=medical_data
# MEDICAL_INDEX_NAME=medical_terms_index

# OpenAI Configuration (optional, for LLM features)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=gpt-4o-mini

# Server Configuration
PORT=3000
NODE_ENV=development

# Sync Service Configuration
SYNC_INTERVAL_MINUTES=60
SYNC_ENABLED=true

# Logging
LOG_LEVEL=info
LOG_ELASTICSEARCH_QUERIES=false

# Medical Term Classifier Permissions
# Set to 'true' to allow model to add/classify new medical terms
# Set to 'false' to restrict model to read-only queries only
ALLOW_MEDICAL_TERM_CLASSIFICATION=false
ALLOW_MEDICAL_TERM_INDEXING=false
